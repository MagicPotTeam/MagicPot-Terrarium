<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/MagicPot.Launcher/*.cs" Exclude="../../src/MagicPot.Launcher/Program.cs" Link="LauncherSource/%(Filename)%(Extension)" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <ProjectReference Include="../MagicPot.Launcher.FakeApp/MagicPot.Launcher.FakeApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
