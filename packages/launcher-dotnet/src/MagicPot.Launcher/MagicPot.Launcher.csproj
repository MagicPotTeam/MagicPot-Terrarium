<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(BuildAsLibrary)' != 'true'">WinExe</OutputType>
    <OutputType Condition="'$(BuildAsLibrary)' == 'true'">Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>MagicPot.Launcher</AssemblyName>
    <RootNamespace>MagicPot.Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(LauncherGeneratedUpdateConfig)' != ''">
    <Compile Remove="CompiledLauncherUpdateConfiguration.Default.cs" />
    <Compile Remove="CompiledLauncherUpdateConfiguration.Generated.cs" />
    <Compile Include="$(LauncherGeneratedUpdateConfig)" Link="CompiledLauncherUpdateConfiguration.Generated.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(BootstrapGeneratedTrustConfig)' != ''">
    <Compile Remove="CompiledBootstrapTrustConfiguration.Default.cs" />
    <Compile Remove="CompiledBootstrapTrustConfiguration.Generated.cs" />
    <Compile Include="$(BootstrapGeneratedTrustConfig)" Link="CompiledBootstrapTrustConfiguration.Generated.cs" />
  </ItemGroup>
</Project>
